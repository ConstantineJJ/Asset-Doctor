{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Local window and files explicitly selected in native open/save dialogs.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-close",
    "core:window:allow-destroy",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-message",
    "fs:allow-read-file",
    "fs:allow-stat",
    "fs:allow-write-file"
  ]
}
